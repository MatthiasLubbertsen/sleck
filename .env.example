# Required
# Public URL of this app, no trailing slash. Browser sessions and OAuth both use it (cookies, CSRF, WebSocket origin).
APP_URL=https://sleck.example.com
# 32+ random chars. Signs the session cookie.   openssl rand -base64 48
SESSION_SECRET=
# Exactly 32 bytes as 64 hex chars or base64. Encrypts stored Slack credentials (AES-256-GCM).   openssl rand -hex 32
ENCRYPTION_KEY=

# Recommended when anyone else could reach the URL: only these Slack user ids may sign in (comma separated)
# ALLOWED_USER_IDS=U0123ABCD

# Optional: "Sign in with Slack" (official OAuth app) + Events API. Not needed for browser-session sign-in.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Optional
# PORT=3000
# DATA_DIR=./data

# docker-compose only: host used in the Traefik router rule (same host as APP_URL)
# SLECK_HOST=sleck.example.com
