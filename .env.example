# Slack app credentials (Basic Information page of your Slack app)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Public URL of this app, no trailing slash. Must match the redirect URL in the Slack app.
APP_URL=https://sleck.example.com

# 32+ random chars. Signs the session cookie.   openssl rand -base64 48
SESSION_SECRET=
# Exactly 32 bytes as 64 hex chars or base64. Encrypts stored Slack tokens (AES-256-GCM).   openssl rand -hex 32
ENCRYPTION_KEY=

# Optional
# PORT=3000
# DATA_DIR=./data
# SLACK_EVENTS=auto        # auto | on | off  (off = always poll, on = never poll)

# docker-compose only: host used in the Traefik router rule (same host as APP_URL)
# SLECK_HOST=sleck.example.com
